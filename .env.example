# Optional persistent settings — copy to /workspace/.comfypod/env on the pod.
#
# SECRETS DO NOT BELONG HERE. Credentials and API tokens live in
# /workspace/.comfypod/secrets.env (0600), managed with `comfypod-secrets`
# (or seeded once from RunPod Secrets — see docs/RUNPOD_TEMPLATE.md).
# This file is for non-secret tuning knobs only.

# Model presets fetched on boot: krea2, krea2-raw, wan22-5b, wan22-t2v,
# wan22-i2v, upscale — or "all" / "none"
export DOWNLOAD_PRESETS="${DOWNLOAD_PRESETS:-krea2,wan22-5b,wan22-t2v,wan22-i2v,upscale}"

# Extra custom nodes (comma-separated git URLs, optionally url@commit)
#export EXTRA_NODES="${EXTRA_NODES:-}"

# Extra ComfyUI CLI flags, e.g. "--fast" or "--highvram"
#export COMFYUI_FLAGS="${COMFYUI_FLAGS:-}"

# Update repo/ComfyUI automatically on boot (default: stay pinned; update
# explicitly with `comfypod-update`, roll back with `comfypod-snapshot`)
export AUTO_UPDATE="${AUTO_UPDATE:-false}"

# SageAttention: auto (installed for the per-workflow KJNodes patch node)
#              | global (also pass --use-sage-attention — known to produce
#                black output on Wan/Qwen models; not recommended)
#              | off
export SAGE_ATTENTION="${SAGE_ATTENTION:-auto}"

# ComfyUI --fast optimizations.
#   fp16_accumulation (default) — big sampling speedup on 40/50-series,
#                                negligible quality cost
#   all                         — every --fast feature (fp8_matrix_mult,
#                                 cublas_ops, autotune); faster but upstream
#                                 labels them "potentially quality
#                                 deteriorating" and they can crash
#   off                         — stock behaviour
export FAST_MODE="${FAST_MODE:-fp16_accumulation}"

# ComfyUI-Manager security level: weak | normal | normal- | strong.
# RunPod's proxy forces a 0.0.0.0 bind, which Manager treats as "not local";
# in that mode only 'weak' allows installing unlisted/git-URL nodes. Access is
# still gated by the ComfyUI-Login password. Use 'normal' to permit only
# registry nodes (Manager then refuses git-URL installs).
export MANAGER_SECURITY_LEVEL="${MANAGER_SECURITY_LEVEL:-weak}"

# Torch pin. The default is the newest mutually consistent triple (torchaudio
# caps at 2.11.0) on the cu128 index — CUDA 12.8 covers Blackwell sm_120 and
# works with older drivers than the cu130 wheels do.
#export TORCH_SPEC="${TORCH_SPEC:-torch==2.11.0 torchvision==0.26.0 torchaudio==2.11.0}"
#export TORCH_INDEX="${TORCH_INDEX:-https://download.pytorch.org/whl/cu128}"

# true: FileBrowser + Jupyter bind to 127.0.0.1 — reachable only through an
# SSH tunnel (ssh -L 8080:localhost:8080 -L 8888:localhost:8888 ...)
export ADMIN_LOCAL_ONLY="${ADMIN_LOCAL_ONLY:-false}"

# Stop the pod after N fully idle minutes (no job, no open UI tab, no
# download). 0 disables. Requires runpodctl + RUNPOD_API_KEY on the pod.
export IDLE_TIMEOUT_MINUTES="${IDLE_TIMEOUT_MINUTES:-30}"

# container: venv rebuilt on container disk each boot from the lockfile via
#            uv (fast imports). volume: venv persisted on /workspace.
export VENV_LOCATION="${VENV_LOCATION:-container}"

export ENABLE_JUPYTER="${ENABLE_JUPYTER:-true}"
