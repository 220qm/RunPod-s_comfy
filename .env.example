# Optional persistent settings — copy to /workspace/.comfypod/env on the pod.
# Values set in the RunPod template always win because of the ${VAR:-...} form.
# Prefer RunPod Secrets for tokens (see docs/RUNPOD_TEMPLATE.md); use this file
# only if you understand it stores secrets in plaintext on your volume.

# Login for ComfyUI, the dashboard, and FileBrowser (Jupyter token = password)
export WEB_USER="${WEB_USER:-admin}"
#export WEB_PASSWORD="${WEB_PASSWORD:-change-me}"

# API tokens for model downloads (gated HuggingFace repos, Civitai)
#export HF_TOKEN="${HF_TOKEN:-hf_...}"
#export CIVITAI_TOKEN="${CIVITAI_TOKEN:-...}"

# Model presets fetched on boot: krea2, krea2-raw, wan22-t2v, wan22-i2v,
# wan22-5b, upscale — or "all" / "none"
export DOWNLOAD_PRESETS="${DOWNLOAD_PRESETS:-krea2,wan22-t2v,wan22-i2v,upscale}"

# Extra custom nodes (comma-separated git URLs)
#export EXTRA_NODES="${EXTRA_NODES:-}"

# Extra ComfyUI CLI flags, e.g. "--fast" for fp16-accumulation speedups
#export COMFYUI_FLAGS="${COMFYUI_FLAGS:-}"

# Update repo/ComfyUI automatically on boot (default: stay pinned, update
# explicitly with `comfypod-update`)
export AUTO_UPDATE="${AUTO_UPDATE:-false}"

# SageAttention: auto (v1 now + compile v2 in background) | 1 (v1 only) | off
export SAGE_ATTENTION="${SAGE_ATTENTION:-auto}"

export ENABLE_JUPYTER="${ENABLE_JUPYTER:-true}"
